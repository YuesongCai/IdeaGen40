<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ideagen40.serve</string>
  <key>ProgramArguments</key>
  <array>
    <!-- Entry point is scripts/serve.py rather than the module directly: it
         resolves inference for this process only, so 「问它当时怎么想」 can
         answer here while ad-hoc CLI runs stay model-free. -->
    <string>/Library/Frameworks/Python.framework/Versions/3.12/bin/python3</string>
    <string>/Users/yuesongcai/IdeaGen40/scripts/serve.py</string>
    <string>--port</string><string>8765</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/yuesongcai/IdeaGen40</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/yuesongcai/IdeaGen40/data/logs/serve.log</string>
  <key>StandardErrorPath</key><string>/Users/yuesongcai/IdeaGen40/data/logs/serve.err</string>
</dict>
</plist>
