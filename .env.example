# Copy to a Git-ignored environment file and fill values locally.
# Never commit access keys, database passwords, OAuth tokens, or dashboard keys.

IDEAGEN_PLATFORM=byteplus
# public-synthetic | shelf-fixture | olive-live | olive-auto | wisburg-auto
IDEAGEN_POC_WEEKLY_MODE=wisburg-auto
IDEAGEN_TICK_INTERVAL_S=300
# Required by wisburg-auto: ingest the licensed research window into private RDS/TOS.
IDEAGEN_CLOUD_WISBURG_ENABLED=true
# Keep licensed product names redacted from the browser payload.
IDEAGEN_DASH_SHOW_LICENSED_NAMES=false

IDEAGEN_STATE_ENGINE=mysql
IDEAGEN_MYSQL_HOST=
IDEAGEN_MYSQL_PORT=3306
IDEAGEN_MYSQL_DATABASE=
IDEAGEN_MYSQL_USER=
IDEAGEN_MYSQL_PASSWORD=
IDEAGEN_MYSQL_SSL_CA=
IDEAGEN_MYSQL_CONNECT_TIMEOUT=10

IDEAGEN_TOS_BUCKET=
IDEAGEN_TOS_PREFIX=
IDEAGEN_TOS_ENDPOINT=

VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=
VOLCENGINE_REGION=ap-southeast-1

ARK_API_KEY=
# OpenAI-compatible inference endpoint supplied by the deployment owner.
ARK_BASE_URL=
ARK_MODEL_ID=
ARK_TIMEOUT_SECONDS=600
ARK_MAX_RETRIES=1
# claude = 推理关闭（观察节点默认）；modelark = 用上面的 ARK_* 直连推理
IDEAGEN_INFERENCE_MODE=
# runner = 本机跑周产；observer = 只盯市与展示，周产由生产实例承担
IDEAGEN_WEEKLY_ROLE=
# 观察节点把「问当时的它」转发到生产实例（如 https://<prod-host>）；
# 转发时用 IDEAGEN_ASK_UPSTREAM_KEY 作为对端的 IDEAGEN_DASH_KEY
IDEAGEN_ASK_UPSTREAM=
IDEAGEN_ASK_UPSTREAM_KEY=

# Third-party endpoints are intentionally not distributed in source packages.
WISBURG_MCP_URL=
WISBURG_REFERER=
WISBURG_API_KEY=

OLIVE_MCP_URL=
OLIVE_OAUTH_ISSUER=
OLIVE_OAUTH_TOKEN_URL=
OLIVE_OAUTH_CLIENT_ID=
OLIVE_OAUTH_REDIRECT_URI=http://127.0.0.1:8766/callback
OLIVE_OAUTH_ACCESS_TOKEN=
OLIVE_OAUTH_REFRESH_TOKEN=
OLIVE_OAUTH_TOKEN_EXPIRES_AT=
# Remote dashboard OAuth writes here; keep it outside the repository.
IDEAGEN_OLIVE_TOKEN_FILE=
IDEAGEN_PUBLIC_SITE=https://<dashboard-host>

IDEAGEN_DASH_KEY=
IDEAGEN_LARK_NOTIFY_USER_ID=
IDEAGEN_LARK_CLI=lark-cli
