# IdeaGen40 · Caddy 反向代理配置
#
# dashboard 只在 compose 内网监听 8765，本代理转发到它。
# Dashboard 自身仍要求 IDEAGEN_DASH_KEY，所以代理不重复鉴权。
#
# IDEAGEN_PUBLIC_SITE 默认为 :80，仅用于不发送 key 的联调。设置为
# https://<public-ip> 可申请 Let's Encrypt 短期 IP 证书；设置为域名时
# Caddy 自动申请域名证书。
#
# 默认运行日志会记录 5xx 请求的 headers。删除整个 request headers 字段，
# 防止 X-Dash-Key、Cookie 或未来新增的认证头进入容器日志。
{
	# 部分客户端访问字面 IP 时不发送 SNI；为它们选择已签发的 IP 证书。
	# 域名客户端会发送自己的 SNI，不受此默认值影响。
	default_sni {$IDEAGEN_DEFAULT_SNI:localhost}

	cert_issuer acme https://acme-v02.api.letsencrypt.org/directory {
		profile shortlived
	}

	log default {
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri delete
			}
		}
	}
}

{$IDEAGEN_PUBLIC_SITE::80} {
	# 用户名 + 密码，浏览器自己弹框、自己记住。
	# 之前是 `?key=<钥匙>`：第一次访问要把钥匙贴进地址栏，于是钥匙进了 URL、
	# 浏览器历史和沿途每一段代理日志。密码走 Authorization 头，不进 URL，
	# 也不需要人把秘密复制来复制去——但它每个请求都在链路上重放一次，
	# 所以这一段只有在 HTTPS 下才成立，见上面的 IDEAGEN_PUBLIC_SITE。
	basic_auth {
		{$IDEAGEN_DASH_USER} {$IDEAGEN_DASH_HASH}
	}

	# 门禁到此为止。dashboard 自己那道 IDEAGEN_DASH_KEY 由代理代为满足，
	# 人不该被要求过两道同样的门；钥匙留在服务端，永远不出现在浏览器里。
	reverse_proxy dashboard:8765 {
		header_up X-Dash-Key {$IDEAGEN_DASH_KEY}
	}
}

# 明文进来的一律送去 HTTPS。留一个 :80 是因为人手输地址时不会打 https://，
# 而一个「打不开」的首页和一个不安全的首页一样糟。
http://{$IDEAGEN_PUBLIC_HOST:101.47.152.106} {
	redir https://{host}{uri} permanent
}
